{
  "name": "@hotella/pms-simulator",
  "version": "0.0.0",
  "private": true,
  "description": "PMS simulator and reference hotel agent (BUILD_PLAN §6.3, ADR-0017): enrolls with a token, holds a durable ordered queue, speaks the agent link over mutual TLS (WSS + HTTPS batches), emits FIAS-shaped and OWS-shaped messages and replays YAML scenarios.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hotella-sim": "./dist/main.js"
  },
  "files": [
    "dist",
    "scenarios"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hotella/contracts-connectors": "workspace:*",
    "@hotella/platform-pki": "workspace:*",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hotella/contracts-api": "workspace:*",
    "@hotella/contracts-events": "workspace:*",
    "@hotella/domain-guest": "workspace:*",
    "@hotella/domain-integrations": "workspace:*",
    "@hotella/domain-organization": "workspace:*",
    "@hotella/platform-audit": "workspace:*",
    "@hotella/platform-auth": "workspace:*",
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-database": "workspace:*",
    "@hotella/platform-events": "workspace:*",
    "@hotella/platform-flags": "workspace:*",
    "@hotella/platform-http": "workspace:*",
    "@hotella/platform-i18n": "workspace:*",
    "@hotella/platform-manifest": "workspace:*",
    "@hotella/platform-observability": "workspace:*",
    "@hotella/platform-queue": "workspace:*",
    "@hotella/platform-secrets": "workspace:*",
    "@hotella/platform-settings": "workspace:*",
    "@hotella/platform-testing": "workspace:*",
    "@hotella/tooling": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "drizzle-orm": "0.45.3",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.1",
    "vitest": "4.1.11"
  }
}
