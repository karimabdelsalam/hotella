{
  "name": "@hotella/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Hotella worker (NestJS 11): outbox relay, BullMQ queue workers (selected by WORKER_QUEUES), scheduler. Same image as the API, different entry point.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hotella/contracts-events": "workspace:*",
    "@hotella/domain-guest": "workspace:*",
    "@hotella/domain-identity": "workspace:*",
    "@hotella/domain-integrations": "workspace:*",
    "@hotella/domain-operations": "workspace:*",
    "@hotella/domain-organization": "workspace:*",
    "@hotella/platform-audit": "workspace:*",
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-database": "workspace:*",
    "@hotella/platform-events": "workspace:*",
    "@hotella/platform-flags": "workspace:*",
    "@hotella/platform-i18n": "workspace:*",
    "@hotella/platform-manifest": "workspace:*",
    "@hotella/platform-observability": "workspace:*",
    "@hotella/platform-queue": "workspace:*",
    "@hotella/platform-secrets": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "pino": "10.4.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@hotella/platform-testing": "workspace:*",
    "@hotella/tooling": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "chokidar": "5.0.0",
    "supertest": "7.3.1",
    "vitest": "4.1.11"
  }
}
