{
  "name": "@hotella/staff-web",
  "version": "0.0.0",
  "private": true,
  "description": "Staff web portal (ADR-0009): Next.js 16 App Router, next-intl on the shared ICU catalog, Tailwind 4 with logical properties. Phase 4: the unified guest inbox.",
  "scripts": {
    "messages": "node scripts/sync-messages.mjs",
    "build": "node scripts/sync-messages.mjs && next build",
    "dev": "node scripts/sync-messages.mjs && next dev --port 3100",
    "start": "next start --port 3100",
    "typecheck": "node scripts/sync-messages.mjs && tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "clean": "rm -rf .next src/messages/*.json"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@hotella/platform-config": "workspace:*",
    "@hotella/ui": "workspace:*",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@hotella/tooling": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
