  <ItemGroup>
    <ProjectReference Include="../Hotella.Agent.Core/Hotella.Agent.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hotella.Agent.Tests" />
  </ItemGroup>
</Project>
