<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- The hotel agent (ADR-0017): a Windows service or systemd unit that links the hotel's PMS to the platform. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>hotella-agent</AssemblyName>
    <RootNamespace>Hotella.Agent</RootNamespace>
    <UserSecretsId></UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Hotella.Agent.Core/Hotella.Agent.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="agent.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
