<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    The hotel agent's MSI (ADR-0020): a thin shell over `hotella-agent setup`. Built on Windows only:
      dotnet build HotellaAgent.wixproj -c Release -p:Version=<x.y.z> -p:AgentPublishDir=<win-x64 publish dir>\
    (packaging/windows/build-msi.ps1 does the publish and this build).
  -->
  <PropertyGroup>
    <Version Condition=" '$(Version)' == '' ">0.0.0</Version>
    <OutputName>hotella-agent-$(Version)-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <DefineConstants>Version=$(Version);AgentPublishDir=$(AgentPublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="HotellaSetupActions\HotellaSetupActions.csproj" />
  </ItemGroup>
</Project>
