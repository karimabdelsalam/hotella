{
  "name": "@hotella/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hotella platform API (NestJS 11). Composes platform and domain modules; exposes /api/v1.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage",
    "iam:bootstrap-admin": "node dist/cli/bootstrap-admin.js"
  },
  "dependencies": {
    "@hotella/contracts-api": "workspace:*",
    "@hotella/domain-ai": "workspace:*",
    "@hotella/domain-catalog": "workspace:*",
    "@hotella/domain-communications": "workspace:*",
    "@hotella/domain-guest": "workspace:*",
    "@hotella/domain-identity": "workspace:*",
    "@hotella/domain-integrations": "workspace:*",
    "@hotella/domain-knowledge": "workspace:*",
    "@hotella/domain-operations": "workspace:*",
    "@hotella/domain-organization": "workspace:*",
    "@hotella/platform-audit": "workspace:*",
    "@hotella/platform-auth": "workspace:*",
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-database": "workspace:*",
    "@hotella/platform-events": "workspace:*",
    "@hotella/platform-flags": "workspace:*",
    "@hotella/platform-http": "workspace:*",
    "@hotella/platform-i18n": "workspace:*",
    "@hotella/platform-manifest": "workspace:*",
    "@hotella/platform-observability": "workspace:*",
    "@hotella/platform-queue": "workspace:*",
    "@hotella/platform-secrets": "workspace:*",
    "@hotella/platform-settings": "workspace:*",
    "@hotella/platform-storage": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "ioredis": "5.11.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hotella/tooling": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
