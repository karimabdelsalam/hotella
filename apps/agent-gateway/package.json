{
  "name": "@hotella/agent-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Hotel-agent gateway (ADR-0017): the internet-facing endpoint hotel agents connect OUT to — enrollment, certificate renewal, WSS link and HTTPS batches over TLS 1.3 with client certificates. Runs the Nest application context only: no staff routes are served on this port.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hotella/domain-identity": "workspace:*",
    "@hotella/domain-integrations": "workspace:*",
    "@hotella/domain-licensing": "workspace:*",
    "@hotella/domain-organization": "workspace:*",
    "@hotella/platform-audit": "workspace:*",
    "@hotella/platform-auth": "workspace:*",
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-database": "workspace:*",
    "@hotella/platform-events": "workspace:*",
    "@hotella/platform-flags": "workspace:*",
    "@hotella/platform-i18n": "workspace:*",
    "@hotella/platform-manifest": "workspace:*",
    "@hotella/platform-observability": "workspace:*",
    "@hotella/platform-secrets": "workspace:*",
    "@hotella/platform-settings": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@hotella/tooling": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13"
  }
}
