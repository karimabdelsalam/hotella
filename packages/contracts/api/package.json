{
  "name": "@hotella/contracts-api",
  "version": "0.0.0",
  "private": true,
  "description": "Shared HTTP API contracts (zod): primitives, cursor pagination, Problem Details shape. Depends on zod only.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hotella/tooling": "workspace:*",
    "vitest": "4.1.11"
  }
}
