{
  "name": "@hotella/platform-manifest",
  "version": "0.0.0",
  "private": true,
  "description": "Module manifests (Spec §76): every bounded context declares its permissions, events, entitlements, AI tools, locale namespaces, integration capabilities and data classes; the registry validates them at boot.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hotella/contracts-events": "workspace:*",
    "@hotella/platform-database": "workspace:*",
    "@nestjs/common": "11.2.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hotella/tooling": "workspace:*",
    "vitest": "4.1.11"
  }
}
