{
  "name": "@hotella/platform-flags",
  "version": "0.0.0",
  "private": true,
  "description": "Feature flags (Spec §73): release control by platform/tenant/property scope. Not licensing (Spec §60) — entitlements live in the license context.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hotella/contracts-events": "workspace:*",
    "@hotella/platform-database": "workspace:*",
    "@hotella/platform-events": "workspace:*",
    "@hotella/platform-observability": "workspace:*",
    "@nestjs/common": "11.2.7",
    "drizzle-orm": "0.45.3",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-testing": "workspace:*",
    "@hotella/tooling": "workspace:*",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vitest": "4.1.11"
  }
}
