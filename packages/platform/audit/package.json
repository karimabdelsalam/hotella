{
  "name": "@hotella/platform-audit",
  "version": "0.0.0",
  "private": true,
  "description": "Append-only audit log (Spec §68, CLAUDE.md rule 5): AuditWriter records important mutations in the same transaction with actor, reason, approval/policy refs and correlation id; sensitive fields are redacted by data class.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hotella/contracts-api": "workspace:*",
    "@hotella/platform-auth": "workspace:*",
    "@hotella/platform-database": "workspace:*",
    "@hotella/platform-i18n": "workspace:*",
    "@hotella/platform-manifest": "workspace:*",
    "@hotella/platform-observability": "workspace:*",
    "@nestjs/common": "11.2.7",
    "drizzle-orm": "0.45.3",
    "nestjs-zod": "5.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-testing": "workspace:*",
    "@hotella/tooling": "workspace:*",
    "@nestjs/core": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vitest": "4.1.11"
  }
}
