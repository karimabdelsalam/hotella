{
  "name": "@hotella/platform-secrets",
  "version": "0.0.0",
  "private": true,
  "description": "SecretRef resolution through pluggable SecretProviders (ADR-0010). Dev/test: env://; production: Vault adapter.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7"
  },
  "devDependencies": {
    "@hotella/tooling": "workspace:*",
    "vitest": "4.1.11"
  }
}
