{
  "name": "@hotella/platform-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Authorization skeleton (Spec \u00a75, \u00a760): request actor, @RequirePermission/@PropertyScoped guards over a pluggable PermissionResolver, and the ActionGate pipeline (authorization \u2192 entitlement \u2192 feature \u2192 configuration \u2192 connector capability \u2192 AI policy).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-flags": "workspace:*",
    "@hotella/platform-i18n": "workspace:*",
    "@hotella/platform-observability": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "nestjs-cls": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hotella/platform-http": "workspace:*",
    "@hotella/tooling": "workspace:*",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "vitest": "4.1.11"
  }
}
