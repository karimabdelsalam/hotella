{
  "name": "@hotella/platform-storage",
  "version": "0.0.0",
  "private": true,
  "description": "S3-compatible object storage (SeaweedFS on-prem, ADR-0013). Binary objects never live in PostgreSQL (Spec §2.4).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-secrets": "workspace:*",
    "@nestjs/common": "11.2.7"
  },
  "devDependencies": {
    "@hotella/platform-testing": "workspace:*",
    "@hotella/tooling": "workspace:*",
    "vitest": "4.1.11"
  }
}
