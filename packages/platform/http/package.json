{
  "name": "@hotella/platform-http",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP conventions for all Hotella apps (ADR-0012): Problem Details filter, idempotency keys, rate limiting, OpenAPI, app bootstrap.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "hotella-build",
    "dev": "hotella-build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hotella/contracts-api": "workspace:*",
    "@hotella/platform-config": "workspace:*",
    "@hotella/platform-i18n": "workspace:*",
    "@hotella/platform-observability": "workspace:*",
    "@hotella/platform-queue": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "ioredis": "5.11.1",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hotella/platform-testing": "workspace:*",
    "@hotella/tooling": "workspace:*",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "vitest": "4.1.11"
  }
}
