# Copy to .env for local development. Dev-only values; production injects secrets via the SecretProvider (ADR-0010).
NODE_ENV=development
APP_NAME=hotella-api
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgresql://hotella:hotella@localhost:5432/hotella
VALKEY_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:3200
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hotella
STORAGE_FORCE_PATH_STYLE=true
# SecretRefs (where the secret lives), resolved by the SecretProvider; dev values below are env:// targets
STORAGE_ACCESS_KEY_REF=env://STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY_REF=env://STORAGE_SECRET_KEY
STORAGE_ACCESS_KEY=hotella
STORAGE_SECRET_KEY=hotella-dev-only
# Worker
WORKER_QUEUES=all
WORKER_PORT=3001
WORKER_RELAY_INTERVAL_MS=500
WORKER_SCHEDULER_ENABLED=true
# Localization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
# HTTP
RATE_LIMIT_PER_MINUTE=600
OPENAPI_ENABLED=true
# Staff identity (ADR-0011). Leave the key refs empty in development: the API then generates ephemeral keys at boot
# (sessions and MFA enrolments do not survive a restart). Production requires both, e.g. vault://iam/jwt#private_key.
# IAM_JWT_SIGNING_KEY_REF=
# IAM_MFA_KEY_REF=
IAM_ACCESS_TOKEN_TTL_SECONDS=900
IAM_REFRESH_TOKEN_TTL_DAYS=30
IAM_LOGIN_MAX_ATTEMPTS=5
IAM_LOGIN_LOCK_MINUTES=15
IAM_INVITE_TTL_HOURS=72
# Staff notification e-mail (Spec §25); Mailpit from the dev compose. Leave NOTIFY_SMTP_HOST unset to switch e-mail off.
NOTIFY_SMTP_HOST=localhost
NOTIFY_SMTP_PORT=1025
NOTIFY_EMAIL_FROM=no-reply@localhost
# Guest OTP (ADR-0011): codes are derived with an HMAC key given as a SecretRef. Development reads the key from
# COMMS_OTP_HMAC_KEY below; production points the ref at the secret store, e.g. vault://kv/hotella/app#otp_hmac_key.
COMMS_OTP_HMAC_KEY_REF=env://COMMS_OTP_HMAC_KEY
COMMS_OTP_HMAC_KEY=dev-only-otp-key-not-for-production
EVENTS_OUTBOX_RETENTION_DAYS=7
EVENTS_INBOX_RETENTION_DAYS=30
